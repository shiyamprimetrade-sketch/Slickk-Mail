# Never commit credentials, mailbox data, credentials in terminal captures, or backups.
.env
.env.*
!.env.example
*.token
*.key
*.pem
*.pfx
*.p12
credentials*
backups/*
!backups/.gitkeep
logs/
.vscode/settings.json
__pycache__/
.pytest_cache/

# Experimental mailboxes and queue databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.local/
